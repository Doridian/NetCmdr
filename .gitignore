/target
/result
/result-*
/oci-amd64
/oci-arm64

# Bytecode from the tools/ scripts.
__pycache__/

# The bridge built by hand rather than by the flake, under the name the README
# builds it with and under the one `go build ./...` picks for it.
/bridge/netcmdr-bridge
/bridge/bridge

# The built web client; `tools/build-web.sh` regenerates it.
/crates/netcmdr-web/dist/

# The same client gzipped for netcmdr-bridge to embed; `tools/pack-web.sh`
# regenerates it. .gitkeep stays, because go:embed needs the directory to
# exist even in a tree nobody has packed.
/bridge/web/dist/*
!/bridge/web/dist/.gitkeep

# Vendor material — firmware images, client JARs and native libraries,
# decompiled or disassembled output, manuals, datasheets, device certificates.
# All of it is copyrighted and none of it is redistributed from this repo; it
# is only ever a local input to the write-up in research/notes/FINDINGS.md.
# research/SOURCES.md says where to get it, research/README.md how to unpack it.
/research/datasheets/
/research/decompiled/
/research/manuals/
/research/patents/
/research/software/
/research/firmware/*.zip
/research/firmware/extracted/
/research/firmware/work/*.bin
/research/firmware/work/out_client/
/research/firmware/work/out_config/
/research/notes/analysis/*.pem
/research/notes/analysis/*.cer
/research/notes/analysis/*.disasm.txt
/research/notes/analysis/*.strings.txt
/research/notes/analysis/*.symbols.txt
/research/notes/analysis/*.dynsym-demangled.txt
/research/notes/analysis/ghidra-*.txt
/research/notes/analysis/*ReadMe*.txt
